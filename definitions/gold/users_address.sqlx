config {
  type: "incremental",
  schema: "gold",
  name: "users_address",
  uniqueKey: ["user_id"],  
  assertions: {
    uniqueKey: ["user_id"],  
    nonNull: ["user_id"]
  },
  dependencies: ["bootstrap"],
  bigquery: {
    clusterBy: ["user_id", "city"]
  },
  description: "Unified user profile combining user attributes with corresponding address details",
  tags: ["gold", "users", "address"],
  columns: {
    user_id: "Unique user identifier",
    first_name: "User first name",
    last_name: "User last name",
    country: "User country of residence",
    region: "User state or region",
    city: "User city",
    address: "User street address",
    __ingested_at__: "Timestamp when the record was processed into the gold layer"
  },
  metadata: {
    overview: "Unified user profile combining user attributes with corresponding address details. Data quality rules: user_id must be unique and non-null.",
    extraProperties: {
      generic: {
        type: "dimension table",
        system: "users"
      }
    }
  }
}

SELECT
  u.user_id, u.first_name, u.last_name,
  a.country, a.region, a.city, a.address,
  CURRENT_TIMESTAMP() AS __ingested_at__
FROM ${ref("silver", "users")} AS u
INNER JOIN ${ref("silver", "address")} AS a
  ON u.user_id = a.user_id
${when(incremental(), `
  WHERE GREATEST(u.__ingested_at__, a.__ingested_at__) > COALESCE(
    (SELECT MAX(__ingested_at__) FROM ${self()}),
    TIMESTAMP '2026-01-01 00:00:00+00'
  )
`)}
