config {
  type: "incremental",
  schema: "silver",
  name: "address",
  uniqueKey: ["user_id"],  
  assertions: {
    uniqueKey: ["user_id"],  
    nonNull: ["user_id"]
  },
  dependencies: ["bootstrap"],
  bigquery: {
    clusterBy: ["user_id"]
  },
  description: "Incremental upsert of address from bronze.address",
  tags: ["silver", "address", "auto-cleaning"],
  columns: {
    user_id: "Unique user identifier",
    country: "Cleaned country name",
    city: "Cleaned city name",
    region: "Cleaned state or region name",
    address: "Cleaned street address",
    __ingested_at__: "Timestamp when the record was processed into the silver layer"
  },
  metadata: {
    overview: "Incremental upsert of address from bronze.address with cleaned attributes. Data quality rules: user_id must be unique and non-null.",
    extraProperties: {
      generic: {
        type: "dimension table",
        system: "address"
      }
    }
  }
}

WITH cleaned AS (
  SELECT 
    SAFE_CAST(user_id AS INT64) AS user_id,
    TRIM(SAFE_CAST(country AS STRING)) AS country,
    TRIM(SAFE_CAST(city AS STRING)) AS city,
    TRIM(SAFE_CAST(region AS STRING)) AS region,
    TRIM(SAFE_CAST(address AS STRING)) AS address,
    __ingested_at__
  FROM ${ref("bronze", "address")}
  
  ${when(incremental(), `
    WHERE SAFE_CAST(user_id AS INT64) IS NOT NULL 
    AND __ingested_at__ > COALESCE(
      (SELECT MAX(__ingested_at__) FROM ${self()}), 
      TIMESTAMP '2026-01-01 00:00:00+00'
      )
  `)}
),

dedup AS (
  SELECT AS VALUE
    ARRAY_AGG(cleaned ORDER BY __ingested_at__ DESC)[OFFSET(0)]
  FROM cleaned
  GROUP BY user_id
)

SELECT
  user_id,
  country,
  city,
  region,
  address,
  CURRENT_TIMESTAMP() AS __ingested_at__
FROM dedup
