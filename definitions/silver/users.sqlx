config {
  type: "incremental",
  schema: "silver",
  name: "users",
  uniqueKey: ["user_id"],  
  assertions: {
    uniqueKey: ["user_id"],  
    nonNull: ["user_id"]
  },
  dependencies: ["bootstrap"],
  bigquery: {
    clusterBy: ["user_id"]
  },
  description: "Incremental upsert of users from bronze.users",
  tags: ["silver", "users"],
  columns: {
    user_id: "Unique user identifier",
    first_name: "Cleaned user first name",
    last_name: "Cleaned user last name",
    __ingested_at__: "Timestamp when the record was processed into the silver layer"
  },
  metadata: {
    overview: "Incremental upsert of users from bronze.users with cleaned attributes. Data quality rules: user_id must be unique and non-null.",
    extraProperties: {
      generic: {
        type: "dimension table",
        system: "users"
      }
    }
  }
}

WITH cleaned AS (
  SELECT
    SAFE_CAST(user_id AS INT64) AS user_id,
    TRIM(SAFE_CAST(firstName AS STRING)) AS first_name,
    TRIM(SAFE_CAST(lastName AS STRING)) AS last_name,
    __ingested_at__
  FROM ${ref("bronze", "users")}

  ${when(incremental(), `
    WHERE SAFE_CAST(user_id AS INT64) IS NOT NULL 
    AND __ingested_at__ > COALESCE(
      (SELECT MAX(__ingested_at__) FROM ${self()}), 
      TIMESTAMP '2026-01-01 00:00:00+00'
      )
  `)}
),
  
dedup AS (
  SELECT AS VALUE
    ARRAY_AGG(cleaned ORDER BY __ingested_at__ DESC)[OFFSET(0)]
  FROM cleaned
  GROUP BY user_id
)

SELECT
  user_id,
  first_name,
  last_name,
  CURRENT_TIMESTAMP() AS __ingested_at__
FROM dedup
